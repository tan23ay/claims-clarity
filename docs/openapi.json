          "escalationRequired": {
            "type": "boolean"
          },
          "billed": {
            "type": "number"
          },
          "paid": {
            "type": "number"
          },
          "adjusted": {
            "type": "number"
          },
          "policy": {
            "$ref": "#/components/schemas/Policy"
          },
          "provenance": {
            "const": "SYNTHETIC"
          }
        },
        "required": [
          "id",
          "provenance"
        ]
      },
      "Policy": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "document": {
            "type": "string"
          },
          "section": {
            "type": "string"
          },
          "page": {
            "type": "integer"
          },
          "effectiveDate": {
            "type": "string"
          },
          "quote": {
            "type": "string"
          },
          "hash": {
            "type": "string"
          },
          "contentHash": {
            "type": "string"
          },
          "plan": {
            "type": "string"
          },
          "planVersion": {

                "type": "string"
              },
              "username": {
                "type": "string"
              },
              "role": {
                "enum": [
                  "demo",
                  "admin"
                ]
              }
            },
            "required": []
          },
          "token": {
            "type": "string"
          },
          "csrfToken": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "user",
          "csrfToken",
          "expiresAt"
        ]
      },
      "Claim": {
        "type": "object",

# The app intentionally runs a synthetic demo; production mode is refused.
APP_ENV=demo
DEMO_MODE=true
HOST=127.0.0.1
PORT=4173
DATABASE_PATH=storage/claims.sqlite
SESSION_TTL_MINUTES=60
MAX_CALL_LOOKUPS=5
COOKIE_SECURE=false
# Comma-separated exact origins, only needed for a separate frontend.
CORS_ORIGINS=

# Optional admin sign-in. Choose your own password of at least 12 characters.
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=

# Direct TypeSafe adapter. Secrets stay on the server; disabled by default.
JEV_ENABLED=false
JEV_API_KEY=
JEV_MODEL=jev-1.13.0
JEV_TIMEOUT_MS=2500
JEV_MIN_CONFIDENCE=0.8
JEV_MIN_MARGIN=0.2
JEV_ESCALATION_THRESHOLD=0.8
